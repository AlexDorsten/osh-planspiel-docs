{"created": "2025-12-04T07:23:28.249177+00:00", "modified": "2025-12-04T07:45:20.735709+00:00", "id": 17811561, "conceptrecid": "17811560", "doi": "10.5281/zenodo.17811561", "conceptdoi": "10.5281/zenodo.17811560", "doi_url": "https://doi.org/10.5281/zenodo.17811561", "metadata": {"title": "\"How To: Open Source Hardware\" Board Game", "doi": "10.5281/zenodo.17811561", "publication_date": "2025-12-04", "description": "<p>This is a serious game to transfer knowledge on the topic of Open Source Hardware (OSH) development. It is a cooperative board game designed for 3 to 6 players. The shared goal is to collaboratively improve and develop an Open Source Hardware idea by guiding it through all stages of its lifecycle. Throughout the game, players encounter challenges, reflect critically, and identify value opportunities in their project. While working together, players can earn Coins by recognizing and articulating specific Value Dimensions. At the end of the game, the team evaluates both their collective progress and individual contributions.</p>", "access_right": "open", "creators": [{"name": "Schneider, Dorothea", "affiliation": "Technical University of Dresden", "orcid": "0000-0002-6633-5052"}, {"name": "Fr\u00fcholz, Natalie", "affiliation": "Fraunhofer-Gesellschaft", "orcid": "0009-0004-9536-2887"}, {"name": "Rabis, Florian", "affiliation": "Hochschule f\u00fcr Technik und Wirtschaft Dresden \u2013 University of Applied Sciences"}, {"name": "Wiesenh\u00fctter, Katarzyna", "affiliation": "Hochschule f\u00fcr Technik und Wirtschaft Dresden \u2013 University of Applied Sciences"}], "references": ["de Bono, E. (1990). Six Thinking Hats. London: Penguin Books.", "Rabis, F. (2019). Open Source \u00d6konomie - Konzept und Modellierung zur Effizienzmessung unserer Wirtschaft. Diploma thesis.", "remodel.dk. (2018). Value Dimensions. Retrieved from https://remodel.dk/", "Wille, T. (2017). Anforderungen an die Technischen Dokumentation bei Open Source Produktentwicklungsprozessen (OSPE). Master thesis."], "resource_type": {"title": "Other", "type": "publication", "subtype": "other"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "17811560"}}]}}, "title": "\"How To: Open Source Hardware\" Board Game", "links": {"self": "https://zenodo.org/api/records/17811561", "self_html": "https://zenodo.org/records/17811561", "preview_html": "https://zenodo.org/records/17811561?preview=1", "doi": "https://doi.org/10.5281/zenodo.17811561", "self_doi": "https://doi.org/10.5281/zenodo.17811561", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17811561", "reserve_doi": "https://zenodo.org/api/records/17811561/draft/pids/doi", "parent": "https://zenodo.org/api/records/17811560", "parent_html": "https://zenodo.org/records/17811560", "parent_doi": "https://doi.org/10.5281/zenodo.17811560", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17811560", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:17811561/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:17811561/sequence/default", "files": "https://zenodo.org/api/records/17811561/files", "media_files": "https://zenodo.org/api/records/17811561/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:17811561:OSH_Game_Board.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:17811561:OSH_Game_Board.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:17811561:OSH_Game_Board.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:17811561:OSH_Game_Board.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:17811561:OSH_Game_Board.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:17811561:OSH_Game_Board.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/17811561/versions/latest", "latest_html": "https://zenodo.org/records/17811561